# Copy to .env. Never commit secrets. Collectors are read-only. No wallets.

DATABASE_URL=postgres://memecoin:memecoin@127.0.0.1:5435/memecoin

SOLANA_MODE=rpc_dev
SOLANA_RPC_URL=
SOLANA_WS_URL=
SOLANA_GRPC_URL=
SOLANA_GRPC_TOKEN=

BASE_WS_URL=
BASE_HTTP_URL=
ROBINHOOD_WS_URL=
ROBINHOOD_HTTP_URL=
# Optional aliases / failover for Robinhood Pons paper (same key never logged).
RH_RPC_PRIMARY_HTTP=
RH_RPC_PRIMARY_WS=
RH_RPC_FALLBACK_HTTP=
RH_RPC_FALLBACK_WS=

METRICS_ADDR=127.0.0.1:9100
INGEST_CHANNEL_CAPACITY=4096
RUST_LOG=info
